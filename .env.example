# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CORS_ALLOWED_ORIGINS: Comma-separated allowed frontend origins for cross-origin deployments (e.g. Render Static Site).
CORS_ALLOWED_ORIGINS=""

# MEDIA STORAGE CONFIGURATION
# STORAGE_DRIVER: "local" (durable mounted volume) or "s3" (S3-compatible object storage).
# Auto-switches to "s3" when S3_BUCKET, S3_ACCESS_KEY_ID, and S3_SECRET_ACCESS_KEY are provided.
STORAGE_DRIVER="local"
STORAGE_REQUIRE_DURABLE="false"

# MEDIA_STORAGE_DIR: Durable filesystem directory for local/mounted volume media uploads.
# On Render with a Persistent Disk, point this to your persistent mount (e.g. /var/data/media), never /tmp.
MEDIA_STORAGE_DIR="./storage/media"

# S3-Compatible Storage Credentials (AWS S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# MEDIA_TOKEN_SECRET: Secret key used to HMAC-sign private internal media preview/download URLs.
MEDIA_TOKEN_SECRET=""

# Per-file and per-submission upload limits enforced on backend
MAX_PHOTO_SIZE_MB="15"
MAX_VIDEO_SIZE_MB="100"
MAX_PHOTOS_PER_SUBMISSION="12"
MAX_VIDEOS_PER_SUBMISSION="3"
