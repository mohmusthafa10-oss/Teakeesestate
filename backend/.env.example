PROJECT_NAME="Teakees Real Estate CRM"
ENVIRONMENT="production"

# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY="replace-this-with-a-very-long-and-secure-random-secret-key-in-production"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- DATABASE ---
# PostgreSQL (production — Render provides this URL automatically via the PostgreSQL add-on)
DATABASE_URL="postgresql+psycopg2://<username>:<password>@<host>:5432/<dbname>"

# Optional: SQLite for isolated local development (uncomment and comment out the PostgreSQL line)
# DATABASE_URL="sqlite:///./teakees_crm.db"

# Optional pool tuning (defaults used if not set)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# --- CORS ---
# In production, set to your deployed frontend URL
CORS_ORIGINS=["https://your-frontend.onrender.com"]
# For local dev:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- UPLOADS ---
UPLOAD_DIR="./uploads"
# On Render with a persistent disk: UPLOAD_DIR="/var/data/uploads"
